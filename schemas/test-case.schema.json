{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mcpstg/test-case.schema.json",
  "title": "MCPSTGTestCaseMeta",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MCPSTG-[A-Z]+-\\d{2}$"
    },
    "title": { "type": "string", "minLength": 3 },
    "category": {
      "type": "string",
      "enum": [
        "INFO", "CONF", "AUTHN", "AUTHZ", "TOOL", "RSRC", "PRMT", "CTX",
        "AGNT", "INPV", "OUTV", "LOG", "SUPP", "GOV", "TRNS", "GW", "SECR",
        "ABUS", "PRVC"
      ]
    },
    "risk": {
      "type": "string",
      "enum": ["Low", "Medium", "High", "Critical"]
    },
    "testingType": {
      "type": "string",
      "enum": ["Manual", "Automated", "Hybrid"]
    },
    "file": { "type": "string", "pattern": "^tests/[A-Z]+/MCPSTG-[A-Z]+-\\d{2}\\.md$" },
    "mappings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "owaspMcpTop10": { "type": "string" },
        "owaspLlmTop10": { "type": "string" },
        "owaspApiTop10": { "type": "string" },
        "owaspAsvs": { "type": "string" },
        "cwe": { "type": "string" },
        "mitreAtlas": { "type": "string" }
      }
    }
  },
  "required": ["id", "title", "category", "risk", "testingType", "file"]
}
